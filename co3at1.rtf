<!DOCTYPE html>\par
<html lang="en">\par
<head>\par
<meta charset="UTF-8">\par
<meta name="viewport" content="width=device-width, initial-scale=1">\par
<title>Serenity - Mental Wellbeing App</title>\par
<style>\par
*\{box-sizing:border-box;margin:0;padding:0;font-family:Arial,sans-serif\}\par
body\{background:#dfe6f1;display:flex;justify-content:center;padding:16px\}\par
#app\{width:360px;height:720px;background:#f7f9fc;border-radius:28px;overflow:hidden;\par
     position:relative;box-shadow:0 8px 28px rgba(0,0,0,.25)\}\par
.screen\{display:none;height:100%;padding:28px 22px 80px;flex-direction:column\}\par
.screen.active\{display:flex\}\par
h1\{color:#4a3f9f;font-size:26px;margin-bottom:6px\}\par
p.sub\{color:#777;font-size:13px;margin-bottom:18px\}\par
.logo\{width:76px;height:76px;border-radius:50%;margin:30px auto 14px;\par
      background:linear-gradient(135deg,#7f6bff,#4fd1c5)\}\par
label\{font-size:12px;color:#555;margin:10px 0 4px\}\par
input\{padding:12px;border:1px solid #cfd6e4;border-radius:10px;font-size:14px\}\par
button\{margin-top:20px;padding:14px;border:0;border-radius:12px;color:#fff;\par
       background:#5b4bd6;font-size:15px;font-weight:bold;cursor:pointer\}\par
a\{margin-top:16px;text-align:center;color:#5b4bd6;font-size:13px;cursor:pointer\}\par
.err\{color:#d33;font-size:12px;margin-top:8px;min-height:14px\}\par
.card\{display:flex;gap:12px;background:#fff;border-radius:14px;padding:10px;\par
      margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,.08)\}\par
.thumb\{width:70px;height:70px;border-radius:12px;flex:none\}\par
.card h3\{font-size:14px;color:#2d2d4a;margin-bottom:4px\}\par
.card small\{color:#888;font-size:11px\}\par
.tag\{display:inline-block;margin-left:6px;padding:2px 8px;border-radius:8px;\par
     background:#e9e5ff;color:#5b4bd6;font-size:10px\}\par
nav\{position:absolute;bottom:0;left:0;right:0;height:60px;background:#fff;display:none;\par
    justify-content:space-around;align-items:center;border-top:1px solid #e3e7ef\}\par
nav span\{font-size:13px;color:#888;cursor:pointer\}\par
nav span.on\{color:#5b4bd6;font-weight:bold\}\par
</style>\par
</head>\par
<body>\par
<div id="app">\par
\par
  <!-- 1. USER LOGIN -->\par
  <section class="screen active" id="login">\par
    <div class="logo"></div>\par
    <h1 style="text-align:center">Serenity</h1>\par
    <p class="sub" style="text-align:center">Meditate. Move. Maintain your mind.</p>\par
    <label>Email</label><input id="lemail" type="email" placeholder="you@example.com">\par
    <label>Password</label><input id="lpass" type="password" placeholder="Enter password">\par
    <div class="err" id="lerr"></div>\par
    <button onclick="doLogin()">Log In</button>\par
    <a onclick="show('register')">New to Serenity? Create an account</a>\par
  </section>\par
\par
  <!-- 2. REGISTER -->\par
  <section class="screen" id="register">\par
    <h1>Create Account</h1>\par
    <p class="sub">Start your wellbeing journey today</p>\par
    <label>Full Name</label><input id="rname" placeholder="Your name">\par
    <label>Email</label><input id="remail" type="email" placeholder="you@example.com">\par
    <label>Password</label><input id="rpass" type="password" placeholder="Min 6 characters">\par
    <label>Confirm Password</label><input id="rconf" type="password" placeholder="Repeat password">\par
    <div class="err" id="rerr"></div>\par
    <button onclick="doRegister()">Register</button>\par
    <a onclick="show('login')">Already have an account? Log in</a>\par
  </section>\par
\par
  <!-- 3. HEALTH ROUTINE BLOGS -->\par
  <section class="screen" id="health">\par
    <h1>Health Routine</h1>\par
    <p class="sub">Daily habits for a calmer mind</p>\par
    <div id="list-health"></div>\par
  </section>\par
\par
  <!-- 4. SELF-CARE BLOGS -->\par
  <section class="screen" id="care">\par
    <h1>Self-Care</h1>\par
    <p class="sub">Small acts of kindness to yourself</p>\par
    <div id="list-care"></div>\par
  </section>\par
\par
  <nav id="nav">\par
    <span data-go="health" onclick="show('health')">Health Routine</span>\par
    <span data-go="care" onclick="show('care')">Self-Care</span>\par
    <span onclick="show('login')">Logout</span>\par
  </nav>\par
</div>\par
\par
<script>\par
const blogs = \{\par
  health: [["Morning Stretch Routine", "5 min read", "Exercise", "#7f6bff"],\par
           ["10-Minute Guided Meditation", "10 min read", "Meditation", "#4fd1c5"],\par
           ["Sleep Better Tonight", "6 min read", "Sleep", "#f6ad55"],\par
           ["Hydration & Healthy Eating", "4 min read", "Nutrition", "#68d391"],\par
           ["Evening Wind-Down Yoga", "7 min read", "Yoga", "#fc8181"]],\par
  care:   [["Journaling for Calm", "5 min read", "Mindset", "#9f7aea"],\par
           ["Digital Detox Day", "6 min read", "Balance", "#4299e1"],\par
           ["Gratitude Practice", "3 min read", "Positivity", "#f6ad55"],\par
           ["4-7-8 Breathing Exercise", "4 min read", "Breathing", "#48bb78"],\par
           ["Saying No Without Guilt", "8 min read", "Boundaries", "#ed64a6"]]\par
\};\par
\par
function render(key) \{\par
  document.getElementById("list-" + key).innerHTML = blogs[key].map(b =>\par
    `<div class="card"><div class="thumb" style="background:$\{b[3]\}"></div>\par
     <div><h3>$\{b[0]\}</h3><small>$\{b[1]\}</small><span class="tag">$\{b[2]\}</span></div></div>`\par
  ).join("");\par
\}\par
\par
function show(id) \{\par
  document.querySelectorAll(".screen").forEach(s => s.classList.toggle("active", s.id === id));\par
  document.getElementById("nav").style.display = (id === "health" || id === "care") ? "flex" : "none";\par
  document.querySelectorAll("nav span").forEach(s => s.classList.toggle("on", s.dataset.go === id));\par
\}\par
\par
function doLogin() \{\par
  const e = lemail.value.trim(), p = lpass.value;\par
  if (!e.includes("@") || p.length < 6) \{ lerr.textContent = "Enter a valid email and password."; return; \}\par
  lerr.textContent = ""; show("health");\par
\}\par
\par
function doRegister() \{\par
  if (!rname.value.trim() || !remail.value.includes("@") || rpass.value.length < 6)\par
    \{ rerr.textContent = "Please fill all fields correctly."; return; \}\par
  if (rpass.value !== rconf.value) \{ rerr.textContent = "Passwords do not match."; return; \}\par
  rerr.textContent = ""; show("health");\par
\}\par
\par
render("health"); render("care");\par
</script>\par
</body>\par
</html>\par
\par
\par

