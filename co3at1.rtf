\b0\fs22 <!DOCTYPE html>\par
<html lang="en">\par
<head>\par
<meta charset="UTF-8">\par
<meta name="viewport" content="width=device-width, initial-scale=1">\par
<title>ParkEasy - Smart Parking</title>\par
<style>\par
*\{box-sizing:border-box;margin:0;padding:0;font-family:Arial,sans-serif\}\par
body\{background:#d9e8df;display:flex;justify-content:center;padding:16px\}\par
#app\{width:360px;height:720px;background:#f4faf6;border-radius:28px;overflow:hidden;\par
     position:relative;box-shadow:0 8px 28px rgba(0,0,0,.25)\}\par
.screen\{display:none;height:100%;padding:26px 22px 80px;flex-direction:column\}\par
.screen.active\{display:flex\}\par
h1\{color:#14532d;font-size:24px;margin-bottom:4px\}\par
p.sub\{color:#6b7280;font-size:13px;margin-bottom:14px\}\par
label\{font-size:12px;color:#555;margin:10px 0 4px\}\par
input,select\{padding:12px;border:1px solid #cfe0d5;border-radius:10px;font-size:14px;background:#fff\}\par
button\{margin-top:18px;padding:14px;border:0;border-radius:12px;color:#fff;\par
       background:#16a34a;font-size:15px;font-weight:bold;cursor:pointer\}\par
a\{margin-top:16px;text-align:center;color:#16a34a;font-size:13px;cursor:pointer\}\par
.err\{color:#d33;font-size:12px;margin-top:8px;min-height:14px\}\par
.logo\{width:72px;height:72px;border-radius:18px;margin:36px auto 10px;background:#16a34a;\par
      color:#fff;font:bold 44px Arial;text-align:center;line-height:72px\}\par
.stepper\{display:flex;align-items:center;justify-content:center;gap:24px;margin:8px 0\}\par
.stepper button\{margin:0;width:44px;height:44px;border-radius:50%;font-size:22px;padding:0\}\par
.stepper b\{font-size:34px;color:#14532d\}\par
.pill\{align-self:flex-start;padding:6px 14px;border-radius:16px;background:#dcfce7;\par
      color:#166534;font-size:13px;font-weight:bold;margin-bottom:12px\}\par
.grid\{display:grid;grid-template-columns:repeat(4,1fr);gap:10px\}\par
.slot\{height:62px;border-radius:12px;display:flex;align-items:center;justify-content:center;\par
      font-weight:bold;color:#fff;cursor:pointer\}\par
.free\{background:#22c55e\}.busy\{background:#ef4444;opacity:.85;cursor:not-allowed\}\par
.legend\{font-size:12px;color:#555;margin-top:14px\}\par
.big\{font-size:54px;font-weight:bold;color:#16a34a;text-align:center;margin:6px 0\}\par
.price\{background:#dcfce7;border-radius:12px;padding:12px;margin-top:14px;\par
       text-align:center;color:#14532d;font-weight:bold\}\par
nav\{position:absolute;bottom:0;left:0;right:0;height:60px;background:#fff;display:none;\par
    justify-content:space-around;align-items:center;border-top:1px solid #dbe7df\}\par
nav span\{font-size:12px;color:#888;cursor:pointer\}\par
nav span.on\{color:#16a34a;font-weight:bold\}\par
</style>\par
</head>\par
<body>\par
<div id="app">\par
\par
  <!-- 1. USER LOGIN -->\par
  <section class="screen active" id="login">\par
    <div class="logo">P</div>\par
    <h1 style="text-align:center">ParkEasy</h1>\par
    <p class="sub" style="text-align:center">Find a parking slot anywhere you travel.</p>\par
    <label>Mobile Number / Email</label><input id="luser" placeholder="Enter mobile or email">\par
    <label>Password</label><input id="lpass" type="password" placeholder="Enter password">\par
    <div class="err" id="lerr"></div>\par
    <button onclick="doLogin()">Log In</button>\par
    <a onclick="show('register')">Parking owner? Register empty slots</a>\par
  </section>\par
\par
  <!-- 2. REGISTER COUNT OF EMPTY PARKING -->\par
  <section class="screen" id="register">\par
    <h1>Register Empty Slots</h1><p class="sub">Update your parking lot availability</p>\par
    <label>Parking Lot Name</label><input id="lot" placeholder="City Centre Parking">\par
    <label>Location / Area</label><input id="area" placeholder="Anna Nagar, Chennai">\par
    <label>Total Slots</label><input id="total" type="number" value="12" min="1">\par
    <label>Empty Slots Right Now</label>\par
    <div class="stepper">\par
      <button onclick="change(-1)">-</button><b id="empty">7</b><button onclick="change(1)">+</button>\par
    </div>\par
    <div class="err" id="gerr"></div>\par
    <button onclick="doRegister()">Register Count</button>\par
  </section>\par
\par
  <!-- 3. FREE PARKING SLOTS DISPLAY -->\par
  <section class="screen" id="slots">\par
    <h1>Free Parking Slots</h1><p class="sub">City Centre Parking - Anna Nagar</p>\par
    <div class="pill" id="summary"></div>\par
    <div class="grid" id="grid"></div>\par
    <p class="legend">Green = Free (tap to book) &nbsp;|&nbsp; Red = Occupied</p>\par
  </section>\par
\par
  <!-- 4. BOOKING PARKING SLOTS -->\par
  <section class="screen" id="book">\par
    <h1>Book Parking Slot</h1><p class="sub">Confirm your reservation</p>\par
    <div class="big" id="chosen">A3</div>\par
    <label>Vehicle Number</label><input id="veh" placeholder="TN 01 AB 1234">\par
    <label>Date</label><input id="date" type="date">\par
    <label>Start Time</label><input id="time" type="time" value="10:00">\par
    <label>Duration</label>\par
    <select id="dur" onchange="price()"><option value="1">1 hour</option>\par
      <option value="2" selected>2 hours</option>\par
      <option value="3">3 hours</option><option value="4">4 hours</option></select>\par
    <div class="price" id="cost"></div>\par
    <div class="err" id="berr"></div>\par
    <button onclick="doBook()">Confirm Booking</button>\par
  </section>\par
\par
  <nav id="nav">\par
    <span data-go="register" onclick="show('register')">Register Count</span>\par
    <span data-go="slots" onclick="show('slots')">Free Slots</span>\par
    <span data-go="book" onclick="show('book')">Booking</span>\par
  </nav>\par
</div>\par
\par
<script>\par
const RATE = 40;                                   // Rs. per hour\par
const busy = ["A2", "A4", "B1", "B4", "C3"];       // occupied slots\par
const names = ["A1","A2","A3","A4","B1","B2","B3","B4","C1","C2","C3","C4"];\par
let selected = "A3", emptyCount = 7;\par
\par
function show(id) \{\par
  document.querySelectorAll(".screen").forEach(s => s.classList.toggle("active", s.id === id));\par
  nav.style.display = ["register", "slots", "book"].includes(id) ? "flex" : "none";\par
  document.querySelectorAll("nav span").forEach(s => s.classList.toggle("on", s.dataset.go === id));\par
\}\par
function doLogin() \{\par
  if (luser.value.trim().length < 5 || lpass.value.length < 6)\par
    \{ lerr.textContent = "Enter valid login details."; return; \}\par
  show("slots");\par
\}\par
function change(d) \{\par
  emptyCount = Math.max(0, Math.min(+total.value, emptyCount + d));\par
  empty.textContent = emptyCount;\par
\}\par
function doRegister() \{\par
  if (!lot.value.trim() || !area.value.trim()) \{ gerr.textContent = "Enter lot name and area."; return; \}\par
  show("slots");\par
\}\par
function drawSlots() \{\par
  const free = names.filter(n => !busy.includes(n)).length;\par
  summary.textContent = free + " free of " + names.length + " slots";\par
  grid.innerHTML = names.map(n => busy.includes(n)\par
    ? `<div class="slot busy">$\{n\}</div>`\par
    : `<div class="slot free" onclick="pickSlot('$\{n\}')">$\{n\}</div>`\par
  ).join("");\par
\}\par
function pickSlot(n) \{\par
  selected = n; chosen.textContent = n; price(); show("book");\par
\}\par
function price() \{ cost.textContent = "Rs. " + RATE + " x " + dur.value + " h = Rs. " + RATE * dur.value; \}\par
function doBook() \{\par
  if (veh.value.trim().length < 6) \{ berr.textContent = "Enter a valid vehicle number."; return; \}\par
  berr.style.color = "#16a34a"; berr.textContent = "Slot " + selected + " booked successfully!";\par
\}\par
date.value = new Date().toISOString().slice(0, 10);\par
drawSlots(); price();\par
</script>\par
</body>\par
</html>\par
