    <span data-go="blog" onclick="show('blog')">Blog</span>\par
    <span data-go="diet" onclick="show('diet')">Diet</span>\par
    <span data-go="videos" onclick="show('videos')">Videos</span>\par
    <span data-go="pay" onclick="show('pay')">Premium</span>\par
