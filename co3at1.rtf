<script>\par
const data = \{\par
  blog:   [["5 Habits for a Stronger Morning", "4 min read | Routine"],\par
           ["How Much Protein Do You Need?", "6 min read | Nutrition"],\par
           ["Beginner's Guide to Strength Training", "8 min read | Workout"],\par
           ["Stretching: Before or After?", "3 min read | Recovery"],\par
           ["Walk 10,000 Steps - Is It Worth It?", "5 min read | Cardio"]],\par
  diet:   [["Breakfast - Oats, banana, milk", "350 kcal"], ["Lunch - Rice, dal, veg curry", "620 kcal"],\par
           ["Snack - Sprouts & fruit bowl", "180 kcal"], ["Dinner - Chapati, paneer, salad", "290 kcal"]],\par
  videos: [["20-Min Full Body Burn", "20 min | Beginner"], ["Morning Yoga Flow", "15 min | All levels"],\par
           ["HIIT Cardio Blast", "25 min | Intermediate"], ["Core & Abs Workout", "12 min | Beginner"],\par
           ["Cool-Down Stretch", "10 min | All levels"]]\par
\};\par
let price = 299;\par
\par
function render(key) \{\par
  document.getElementById("list-" + key).innerHTML = data[key].map(d => key === "diet"\par
    ? `<div class="card meal"><h3>$\{d[0]\}</h3><b style="color:#ea580c">$\{d[1]\}</b></div>`\par
    : `<div class="card">$\{key === "videos" ? '<div class="thumb"></div>' : ""\}\par
       <div><h3>$\{d[0]\}</h3><small>$\{d[1]\}</small></div></div>`).join("");\par
\}\par
function show(id) \{\par
  document.querySelectorAll(".screen").forEach(s => s.classList.toggle("active", s.id === id));\par
  nav.style.display = ["blog", "diet", "videos", "pay"].includes(id) ? "flex" : "none";\par
  document.querySelectorAll("nav span").forEach(s => s.classList.toggle("on", s.dataset.go === id));\par
\}\par
function doLogin() \{\par
  if (!lemail.value.includes("@") || lpass.value.length < 6)\par
    \{ lerr.textContent = "Enter a valid email and password."; return; \}\par
  show("blog");\par
\}\par
function doRegister() \{\par
  if (!rname.value.trim() || !remail.value.includes("@") || rpass.value.length < 6 || !rage.value)\par
    \{ rerr.textContent = "Please fill all fields correctly."; return; \}\par
  show("blog");\par
\}\par
function plan(el, p) \{\par
  document.querySelectorAll(".plan").forEach(x => x.classList.remove("sel"));\par
  el.classList.add("sel"); price = p; paybtn.textContent = "Pay Rs. " + p.toLocaleString("en-IN");\par
\}\par
function doPay() \{\par
  if (card.value.replace(/\\s/g, "").length < 16) \{ perr.textContent = "Enter a valid 16-digit card."; return; \}\par
  perr.style.color = "#16a34a"; perr.textContent = "Subscription activated. Enjoy FitLife Premium!";\par
\}\par
["blog", "diet", "videos"].forEach(render);\par
</script>\par
