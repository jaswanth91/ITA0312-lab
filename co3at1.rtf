  <!-- 1. USER LOGIN -->\par
  <section class="screen active" id="login">\par
    <div class="logo"></div>\par
    <h1 style="text-align:center">JobMate</h1>\par
    <p class="sub" style="text-align:center">From search to signed contract, faster.</p>\par
    <label>Email</label><input id="lemail" type="email" placeholder="you@example.com">\par
    <label>Password</label><input id="lpass" type="password" placeholder="Enter password">\par
    <div class="err" id="lerr"></div>\par
    <button onclick="doLogin()">Log In</button>\par
    <a onclick="show('plan')">New user? Register & subscribe</a>\par
  </section>\par
\par
  <!-- 2. REGISTER SUBSCRIPTION -->\par
  <section class="screen" id="plan">\par
    <div class="step">STEP 1 OF 4 - SUBSCRIPTION</div><div class="bar"><i style="width:25%"></i></div>\par
    <h1>Choose your plan</h1><p class="sub">Upgrade or cancel anytime</p>\par
    <div class="plan" onclick="pick(this)">\par
      <div><b>Free</b><br><small>5 job applications / month</small></div><b>Rs. 0</b></div>\par
    <div class="plan sel" onclick="pick(this)">\par
      <div><b>Pro</b><br><small>Unlimited applications + alerts</small></div><b>Rs. 199</b></div>\par
    <div class="plan" onclick="pick(this)">\par
      <div><b>Premium</b><br><small>Resume review + contract help</small></div><b>Rs. 499</b></div>\par
    <button onclick="show('details')">Subscribe &amp; Continue</button>\par
  </section>\par
\par
  <!-- 3. PERSONAL DETAIL -->\par
  <section class="screen" id="details">\par
    <div class="step">STEP 2 OF 4 - PERSONAL DETAILS</div><div class="bar"><i style="width:50%"></i></div>\par
    <h1>About you</h1><p class="sub">Helps us match the right jobs</p>\par
    <label>Full Name</label><input id="dname" placeholder="Your full name">\par
    <label>Phone</label><input id="dphone" type="tel" placeholder="+91 98765 43210">\par
    <label>City</label><input id="dcity" placeholder="Chennai">\par
    <label>Experience</label>\par
    <select><option>Fresher</option><option>1-3 years</option>\par
            <option>3-5 years</option><option>5+ years</option></select>\par
    <label>Key Skills</label><input placeholder="Java, Python, SQL">\par
    <div class="err" id="derr"></div>\par
    <button onclick="doDetails()">Next</button>\par
  </section>\par
\par
  <!-- 4. RESUME UPLOAD -->\par
  <section class="screen" id="resume">\par
    <div class="step">STEP 3 OF 4 - RESUME</div><div class="bar"><i style="width:75%"></i></div>\par
    <h1>Upload resume</h1><p class="sub">PDF or DOC, up to 5 MB</p>\par
    <div class="drop">Drag &amp; drop your resume here<br>or choose a file below</div>\par
    <input id="file" type="file" accept=".pdf,.doc,.docx"\par
           onchange="fname.textContent='Selected file: '+this.files[0].name">\par
    <p class="sub" id="fname" style="margin:8px 0 0">Selected file: none</p>\par
    <div class="err" id="rerr"></div>\par
    <button onclick="doUpload()">Upload &amp; Continue</button>\par
  </section>\par
\par
  <!-- 5. CHOOSING JOB -->\par
  <section class="screen" id="jobs">\par
    <div class="step">STEP 4 OF 4 - CHOOSE A JOB</div><div class="bar"><i style="width:100%"></i></div>\par
    <h1>Jobs for you</h1><p class="sub" id="count"></p>\par
    <div class="chips" id="chips"></div>\par
    <div id="joblist"></div>\par
  </section>\par
</div>\par
\par
<script>\par
const jobs = [["Android Developer", "TechNova - Chennai", "Rs. 8 LPA", "Full-time"],\par
              ["UI/UX Designer", "PixelWorks - Remote", "Rs. 6 LPA", "Remote"],\par
              ["Software Intern", "CodeCraft - Bengaluru", "Rs. 20k / mo", "Internship"],\par
              ["Data Analyst", "InsightIQ - Remote", "Rs. 7 LPA", "Remote"],\par
              ["Backend Engineer", "CloudLeaf - Hyderabad", "Rs. 10 LPA", "Full-time"]];\par
let filter = "All";\par
\par
function show(id) \{\par
  document.querySelectorAll(".screen").forEach(s => s.classList.toggle("active", s.id === id));\par
\}\par
function pick(el) \{\par
  document.querySelectorAll(".plan").forEach(p => p.classList.remove("sel"));\par
  el.classList.add("sel");\par
\}\par
function doLogin() \{\par
  if (!lemail.value.includes("@") || lpass.value.length < 6)\par
    \{ lerr.textContent = "Enter a valid email and password."; return; \}\par
  show("jobs"); drawJobs();\par
\}\par
function doDetails() \{\par
  if (!dname.value.trim() || dphone.value.length < 10 || !dcity.value.trim())\par
    \{ derr.textContent = "Please complete name, phone and city."; return; \}\par
  show("resume");\par
\}\par
function doUpload() \{\par
  if (!file.files.length) \{ rerr.textContent = "Please choose a resume file."; return; \}\par
  show("jobs"); drawJobs();\par
\}\par
function drawJobs() \{\par
  chips.innerHTML = ["All", "Remote", "Full-time", "Internship"].map(c =>\par
    `<span class="chip $\{c === filter ? "on" : ""\}" onclick="filter='$\{c\}';drawJobs()">$\{c\}</span>`).join("");\par
  const list = jobs.filter(j => filter === "All" || j[3] === filter);\par
  count.textContent = list.length + " matches based on your profile";\par
  joblist.innerHTML = list.map(j => `<div class="job"><div><h3>$\{j[0]\}</h3>\par
    <small>$\{j[1]\}</small><small>$\{j[2]\} | $\{j[3]\}</small></div>\par
    <button onclick="this.textContent='Applied'">Apply</button></div>`).join("");\par
\}\par
drawJobs();\par
</script>\par
</body>\par
</html>\par
\par
